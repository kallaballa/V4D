	    -DBUILD_opencv_img_hash=OFF \
	    -DBUILD_opencv_intensity_transform=OFF \
	    -DBUILD_opencv_line_descriptor=OFF \
	    -DBUILD_opencv_mcc=OFF \
	    -DBUILD_opencv_ovis=OFF \
	    -DBUILD_opencv_phase_unwrapping=OFF \
	    -DBUILD_opencv_quality=OFF \
	    -DBUILD_opencv_rapid=OFF \
	    -DBUILD_opencv_reg=OFF \
	    -DBUILD_opencv_rgbd=OFF \
	    -DBUILD_opencv_saliency=OFF \
	    -DBUILD_opencv_sfm=OFF \
	    -DBUILD_opencv_stereo=OFF \
	    -DBUILD_opencv_structured_light=OFF \
	    -DBUILD_opencv_surface_matching=OFF \
	    -DBUILD_opencv_text=OFF \
	    -DBUILD_opencv_xfeatures2d=OFF \
	    -DBUILD_opencv_xobjdetect=OFF \
	    -DBUILD_opencv_xphoto=OFF \
	    -DBUILD_opencv_wechat_qrcode=OFF \
	    -DGBFX_CONFIG_MULTITHREADED=OFF \
	    -DBGFX_CONFIG_PASSIVE=ON

override_dh_auto_build:
	$(MAKE) -C build

override_dh_auto_test:
	@echo "Skipping tests (BUILD_TESTS=OFF)"

override_dh_auto_install:
	$(MAKE) -C build DESTDIR=$(CURDIR)/debian/tmp install
	# nanovg's own CMake installs a duplicate library into /usr/lib on
	# multilib systems; drop the stray copy so it is not flagged as an
	# unpackaged file. The lib/x86_64-linux-gnu copy is the packaged one.
	rm -f debian/tmp/usr/lib/libnanovg.so*
	# OpenCV does not install the C++ example binaries by default; copy them
	# so the plan-v4d-samples package gets its files.
	install -d debian/tmp/usr/bin
	cp -a build/bin/example_v4d_* debian/tmp/usr/bin/ 2>/dev/null || true
	install -d debian/tmp/usr/share/doc/plan-v4d
	install -m 0644 LICENSE debian/tmp/usr/share/doc/plan-v4d/LICENSE
	install -m 0644 CONTRIBUTING.md debian/tmp/usr/share/doc/plan-v4d/CONTRIBUTING.md
	# Plan-DSL documentation
	install -d debian/tmp/usr/share/doc/plan-v4d/plan
	install -m 0644 $(CURDIR)/extra_modules/plan/README.md \
	    debian/tmp/usr/share/doc/plan-v4d/plan/README.md
	install -m 0644 $(CURDIR)/extra_modules/plan/doc/plan-dsl-programming-guide.markdown \
	    debian/tmp/usr/share/doc/plan-v4d/plan/plan-dsl-programming-guide.markdown
	install -m 0644 $(CURDIR)/extra_modules/plan/doc/plan-dsl-reference.markdown \
	    debian/tmp/usr/share/doc/plan-v4d/plan/plan-dsl-reference.markdown
	# V4D documentation
	install -d debian/tmp/usr/share/doc/plan-v4d/v4d
	install -m 0644 $(CURDIR)/extra_modules/v4d/README.md \
	    debian/tmp/usr/share/doc/plan-v4d/v4d/README.md
	install -m 0644 $(CURDIR)/extra_modules/v4d/doc/v4d-application-programming-guide.markdown \
	    debian/tmp/usr/share/doc/plan-v4d/v4d/v4d-application-programming-guide.markdown
	install -d debian/tmp/usr/share/doc/plan-v4d/v4d/samples
	for f in $(CURDIR)/extra_modules/v4d/doc/samples/*.markdown; do \
	    install -m 0644 "$$f" debian/tmp/usr/share/doc/plan-v4d/v4d/samples/ ; \
	done
	# Plan test sources
	install -d debian/tmp/usr/share/plan-v4d/plan/test
	install -m 0644 $(CURDIR)/extra_modules/plan/test/*.cpp \
	    $(CURDIR)/extra_modules/plan/test/*.hpp \
	    debian/tmp/usr/share/plan-v4d/plan/test/
	# V4D sample sources
	install -d debian/tmp/usr/share/plan-v4d/v4d/samples
	install -m 0644 $(CURDIR)/extra_modules/v4d/samples/*.cpp \
	    $(CURDIR)/extra_modules/v4d/samples/*.hpp \
	    debian/tmp/usr/share/plan-v4d/v4d/samples/
	install -d debian/tmp/usr/share/plan-v4d/v4d/samples/fonts
	install -m 0644 $(CURDIR)/extra_modules/v4d/samples/fonts/*.ttf \
	    debian/tmp/usr/share/plan-v4d/v4d/samples/fonts/

override_dh_auto_clean:
	rm -rf build

# Some OpenCV data (e.g. per-subsystem model files) is not explicitly claimed
# by an .install file; do not fail the build for those leftovers.
override_dh_missing:
	@true

# OpenCL ICD shims (ocl-icd-libopencl1 / pocl) don't always carry the symbols
# dpkg-shlibdeps expects. Don't fail the build over an unresolved OpenCL SONAME.
override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info
